# Documentation only: copy to .env.local (git-ignored) to change a value.
# Every VITE_ variable is shipped to the browser, so none of them may ever hold a secret.

# demo = built-in demo data, no network requests. live = KPI cards and the monthly trend call the Lumenore workflows.
VITE_DATA_MODE=demo

# Leave unset during `npm run dev`: requests then go through the local /lumenore-workflow/ dev proxy.
# A production build calls this URL directly unless another value is set.
# VITE_WORKFLOW_BASE_URL=https://apphub.lumenore.com/appsapi/appbuilder/workflow/

# fetch credentials policy: omit | include
VITE_WORKFLOW_CREDENTIALS=omit
